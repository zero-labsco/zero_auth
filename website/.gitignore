# Dependencies
node_modules

# Build outputs — the site is built by CI and published to the `gh-pages`
# branch, so `out/` must never be committed to `main`.
.next
out
dist

# Local env / logs
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
*.pem
Thumbs.db

# TypeScript build info. NOTE: `next-env.d.ts` is deliberately NOT ignored —
# it is checked in, and ignoring it makes `dart pub publish` fail with
# "files that are checked in while gitignored".
*.tsbuildinfo
