# Exclude the GitHub Pages documentation site from the published package.
# The docs/ folder is served via the docs/github-pages branch (GitHub Pages),
# not distributed through pub.dev.
docs/

# Project-internal agent/IDE data — must not be published to pub.dev.
.codebuddy/

# Release/notes files that are repo-internal, not package content.
wiki/
TODO.md
AGENTS.md
CONTRIBUTING.md
KNOWN_RISKS.md

# Local design doc (repo-internal, not package API documentation).
zero_auth_design.md

# Local build artifacts (test caches, native assets) — not needed by consumers.
build/

# Demo backend used only by the example app — not part of the published package.
server/

# Nextra documentation site source — publishes to docs/ via the build pipeline,
# not shipped as package source. Its build output (website/out) is git-ignored.
website/
